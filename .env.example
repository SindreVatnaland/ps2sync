# ps2sync configuration. Copy to .env and edit. All have sane defaults.

# Root data directory (host bind mount target). Holds DVD/ CD/ POPS/ incoming/ db/.
# The sibling Samba container shares DVD/ CD/ POPS/ so the PS2 (OPL) can pull them.
DATA_DIR=/data

# HTTP listen port.
PORT=8080

# Hard cap on a single uploaded file, in bytes. Default 12 GiB (fits a PS2 DVD9).
MAX_UPLOAD_BYTES=12884901888

# Hard cap on a single URL download, in bytes. Default 10 GiB.
MAX_DOWNLOAD_BYTES=10737418240

# Allow URL downloads that resolve/redirect to private IP ranges (SSRF risk). true|false.
ALLOW_PRIVATE_URL_HOSTS=false

# Shared secret. If set, required as bearer token or login cookie. Unset = open (no auth).
AUTH_TOKEN=

# Fastify log level: fatal|error|warn|info|debug|trace|silent.
LOG_LEVEL=info
